---
import { site } from '../lib/site-config';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.site.tagline } = Astro.props;
const heading = `${title} | ${site.business.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/brand/favicon.svg" />
    <title>{heading}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={heading} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/brand/og.png', site.site.url).href} />
  </head>
  <body>
    <header>
      <a href="/">{site.business.name}</a>
      <nav>
        <a href="/services">Services</a>
        <a href="/projects">Projects</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>{site.business.phone} &middot; {site.business.email}</p>
      <p>Serving {site.business.serviceArea.join(', ')}. {site.business.hours}.</p>
      <p><a href="/privacy">Privacy</a></p>
    </footer>
  </body>
</html>
