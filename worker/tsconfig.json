{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true

    // No "paths" entry, and there never is one. A path alias into src/ would
    // make the Worker depend on the site generator, which is the one thing
    // ADR 0001 buys by keeping the generator out of production.
  },
  "include": ["**/*.ts", "../site.config.json"]
}
